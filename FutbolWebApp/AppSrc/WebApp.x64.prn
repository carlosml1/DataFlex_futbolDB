38293>>>        Case Begin
38293>>>            Case (NavigateData.eNavigateType = nfFromMain)
38295>>>                // If from main, this is a propbably a main file Select to Zoom.
38295>>>                Case Break
38296>>>
38296>>>            Case (NavigateData.eNavigateType = nfFromParent)
38299>>>                // If from parent, this is a constrained drill down.
38299>>>                Case Break
38300>>>
38300>>>            Case (NavigateData.eNavigateType = nfFromChild)
38303>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38303>>>                Case Break
38304>>>
38304>>>            Case Else // must be nfUndefined
38304>>>
38304>>>        Case End
38304>>>
38304>>>        Send SetActionButtons
38305>>>
38305>>>    End_Procedure
38306>>>
38306>>>End_Object 
