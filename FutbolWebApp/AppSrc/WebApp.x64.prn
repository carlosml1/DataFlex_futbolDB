38249>>>    Procedure SetActionButtons
38252>>>        tWebNavigateData NavigateData
38252>>>        tWebNavigateData NavigateData
38252>>>        Boolean bHasRecord
38252>>>        Handle hoDD
38252>>>
38252>>>        Get Server to hoDD
38253>>>        Get GetNavigateData to NavigateData
38254>>>        Get HasRecord of hoDD to bHasRecord
38255>>>
38255>>>        // let's hide all buttons and then Show the ones we want
38255>>>        WebSet pbRender of oEditBtn to False
38256>>>        WebSet pbRender of oSaveBtn to False
38257>>>        WebSet pbRender of oCancelChangesBtn to False
38258>>>        WebSet pbRender of oDeleteBtn to False
38259>>>
38259>>>        If (NavigateData.bReadOnly) Begin
38261>>>            WebSet pbRender of oEditBtn to True
38262>>>        End
38262>>>>
38262>>>        Else Begin
38263>>>            WebSet pbRender of oSaveBtn to True
38264>>>            WebSet pbRender of oCancelChangesBtn to True
38265>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38266>>>        End
38266>>>>
38266>>>    End_Procedure
38267>>>
38267>>>    Procedure OnViewSaved Handle hoServer Boolean bChanged
38270>>>        // Close after save
38270>>>        Send NavigateClose Self
38271>>>    End_Procedure
38272>>>
38272>>>    // this will close the view after a delete
38272>>>    Procedure OnViewDeleted Handle hoDDO
38275>>>        Send NavigateClose Self
38276>>>    End_Procedure
38277>>>
38277>>>    Procedure OnNavigateForward tWebNavigateData NavigateData Integer hoInvokingView Integer hoInvokingObject
38280>>>        Case Begin
38280>>>            Case (NavigateData.eNavigateType = nfFromMain)
38282>>>                // If from main, this is a propbably a main file Select to Zoom.
38282>>>                Case Break
38283>>>
38283>>>            Case (NavigateData.eNavigateType = nfFromParent)
38286>>>                // If from parent, this is a constrained drill down.
38286>>>                Case Break
38287>>>
38287>>>            Case (NavigateData.eNavigateType = nfFromChild)
38290>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38290>>>                Case Break
38291>>>
38291>>>            Case Else // must be nfUndefined
38291>>>
38291>>>        Case End
38291>>>
38291>>>        Send SetActionButtons
38292>>>
38292>>>    End_Procedure
38293>>>
38293>>>End_Object 
